Panels: []
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Value: true
      Cell Size: 0.1
      Plane Cell Count: 20
      Color: 100; 115; 135
      Alpha: 0.35
      Plane: XY
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/RobotModel
      Name: Gazebo robot state
      Enabled: true
      Value: true
      Alpha: 1
      Visual Enabled: true
      Collision Enabled: false
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
        Depth: 1
      TF Prefix: ""
  Enabled: true
  Global Options:
    Background Color: 26; 34; 48
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 0.85
      Focal Point:
        X: -0.04
        Y: 0
        Z: 0.16
      Pitch: 0.28
      Yaw: 0.8
      Target Frame: <Fixed Frame>
      Near Clip Distance: 0.01
      Name: Current View
      Value: Orbit (rviz)
Window Geometry:
  Width: 1280
  Height: 720
  X: 0
  Y: 0
  Hide Left Dock: true
  Hide Right Dock: true
